# RECEIVE-ONLY EXAMPLE. Not installed as an active configuration or started
# automatically. Replace the RX ALSA placeholder after mapping the actual AIOC.
# Source-checked against SvxLink 24.02. Calibrate on the actual radio hardware.
# TX=NONE creates a dummy transmitter: no TX audio or PTT device is opened.

[GLOBAL]
LOGICS=RepeaterLogic
TIMESTAMP_FORMAT="%Y-%m-%d %H:%M:%S"
CARD_SAMPLE_RATE=48000
CARD_CHANNELS=1

[RepeaterLogic]
TYPE=Repeater
RX=RxAIOC
TX=NONE
MODULES=
CALLSIGN=N0CALL
ONLINE=0
NO_REPEAT=1
EVENT_HANDLER=/usr/share/svxlink/events.tcl
DEFAULT_LANG=en_US
SHORT_IDENT_INTERVAL=0
LONG_IDENT_INTERVAL=0
RGR_SOUND_DELAY=-1
IDLE_SOUND_INTERVAL=0
IDLE_TIMEOUT=1
OPEN_ON_SQL=100
OPEN_SQL_FLANK=OPEN
STATE_PTY=/run/repeater-rx-monitor/svxlink-state

[RxAIOC]
TYPE=Local
# Replace this with the persistent identity mapped from the actual RX AIOC.
# Card numbers and identical default USB audio names can change after reboot.
AUDIO_DEV=alsa:plughw:CARD=REPLACE_RX_ALSA_ID,DEV=0
AUDIO_CHANNEL=0
SQL_DET=VOX
SQL_START_DELAY=0
SQL_DELAY=0
SQL_HANGTIME=1000
VOX_FILTER_DEPTH=20
VOX_THRESH=1000
SIGLEV_DET=NONE
DEEMPHASIS=0
PEAK_METER=1
DTMF_DEC_TYPE=NONE
RAW_AUDIO_UDP_DEST=127.0.0.1:7355

# The raw tap is mono native float32 at CARD_SAMPLE_RATE; on the Pi it is
# 48 kHz f32le, matching the dashboard hub. It is before software squelch,
# PREAMP, de-emphasis, resampling, and DTMF muting. It excludes TX announcements.
# ONLINE=0 does not mute this receiver tap in a Repeater logic.
# The installer/configure-dtmf.py migrates an existing mapped monitor to the
# restricted event handler with ONLINE=1, DTMF_DEC_TYPE=INTERNAL, and muting.
# The wrapper captures all RF symbols before native command parsing. # submits
# one stage; * cancels. A batch is handled only after software squelch has stayed
# closed for at least 500 ms, checked by SvxLink's native once-per-second event.
# TX=NONE and NO_REPEAT=1 stay fixed. DTMF controls remain disabled in Admin
# until a separate local control code is configured and explicitly enabled.
# The raw tap is before DTMF muting: live audio/archives can contain RF digits.
# Let the RX RADIO mute its speaker audio with hardware squelch/CTCSS.
# Turn radio VOX OFF and battery saving OFF. Calibrate volume/capture levels.
# The VOX numbers above are unmeasured starting values, not calibrated settings.
# N0CALL is a bench placeholder; this file cannot transmit through TX=NONE.
# No serial/PTT device, QSO recorder, radio programming, or link is configured.
