[Unit]
Description=Dispatch one reviewed Repeater Box audio message and recover stale requests
Before=repeater-live.service

[Service]
Type=oneshot
User=root
Group=repeater-control
RuntimeDirectory=repeater-message-playback
RuntimeDirectoryMode=0750
StateDirectory=repeater-message-dispatcher
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/repeater-box/scripts/broadcast-message.py
TimeoutStartSec=65
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/repeater-dashboard /opt/repeater-box/.maintenance.lock
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
